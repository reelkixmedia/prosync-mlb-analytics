# Copy to .env (same folder as app.py) and fill in. .env is git-ignored.
# app.py reads this file at startup via os.environ.get("ODDS_API_KEY").
# Free key: https://the-odds-api.com  (32 characters)
ODDS_API_KEY=your_the_odds_api_key_here

# Optional: folder where the app drops a copy of each night's board CSV.
# Defaults to ~/Downloads if it exists.
# NK_DROP_DIR=/path/to/folder
